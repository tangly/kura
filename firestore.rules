rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your existing user-specific rules for `/users/{userId}`
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }


    // USERS
    match /users/{userId} {
      allow create, read, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }

    // FAMILIES
    match /families/{familyId} {
      function isFamilyMember() {
        return request.auth != null &&
          (request.auth.uid in resource.data.members ||
           request.auth.uid in resource.data.admins);
      }
      function isFamilyAdmin() {
        return request.auth != null &&
          request.auth.uid in resource.data.admins;
      }

      // Read only if user is part of the family
      allow read: if isFamilyMember();

      // Create: authenticated user who is admin of their own new family
      allow create: if request.auth != null &&
        request.resource.data.admins != null &&
        request.auth.uid in request.resource.data.admins;

      // Update/Delete: only family admins
      allow update, delete: if isFamilyAdmin();
    

    // FAMILY_MEMBERS
    match /families/{familyId}/members/{memberId} {
      function getFamilyData(familyId) {
        return get(/databases/$(database)/documents/families/$(familyId)).data;
      }

      function isFamilyAdminForMember(familyId) {
        return request.auth != null && request.auth.uid in getFamilyData(familyId).admins;
      }

      function isFamilyMemberForMember(familyId) {
        return request.auth != null && (request.auth.uid in getFamilyData(familyId).admins || request.auth.uid in getFamilyData(familyId).members);
      }

      // Read: only if user belongs to the related family
      allow read: if isFamilyMemberForMember(familyId);

      // Create: only if user is a member of that family
      allow create: if isFamilyMemberForMember(familyId);

      // Update/Delete: only if user is an admin of that family
      allow update, delete: if isFamilyAdminForMember(familyId);


      
    }
  }



    // Your existing catch-all rule should be considered carefully.
    // Generally, more specific rules (like those for 'users' and 'families')
    // should be placed above or take precedence over very broad rules.
    //match /{document=**} {
    //  allow read, write: if request.time < timestamp.date(2025, 11, 17);
    //}
  }
}
