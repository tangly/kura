rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    

    // AppUser: Only the user can read/update/delete their own document
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Family: Only admins can read/write
    match /families/{familyId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid in resource.data.admins;
      allow create: if request.auth != null;
    }

    // Family Members: Only admins can create/delete, members can read/update themselves
    match /families/{familyId}/members/{memberId} {
      allow read, update: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.admins);
      allow create, delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.admins;
    }
    // Family Members: Only admins can create/delete, members can read/update themselves
    match /families/{familyId}/medications/{medicationId} {
      allow read, update: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.admins);
      allow create, delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.admins;
    }
  



    // Your existing catch-all rule should be considered carefully.
    // Generally, more specific rules (like those for 'users' and 'families')
    // should be placed above or take precedence over very broad rules.
    //match /{document=**} {
    //  allow read, write: if request.time < timestamp.date(2025, 11, 17);
    //}
  }
}
